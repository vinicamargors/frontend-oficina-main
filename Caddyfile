{
	admin off
	auto_https off
}

# TLS é da Cloudflare; aqui só HTTP na rede interna do compose (nenhuma porta é publicada na VM).
:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			health_uri /api/v1/health
			health_interval 10s
			# api reiniciando (troca de versão): espera até 5 s em vez de devolver 502 na hora
			lb_try_duration 5s
			lb_try_interval 500ms
		}
	}

	handle {
		root * /srv
		# Arquivos com hash no nome nunca mudam; o index.html sempre é revalidado (senão a versão nova não chega).
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
